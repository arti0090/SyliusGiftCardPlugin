{% set form = hookable_metadata.context.form %}
{% set resource = hookable_metadata.context.resource %}
{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{{ form_errors(form) }}

<div class="row row-cards mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                {{ form_row(form.code) }}
                <div class="mb-3">
                    {{ form_label(form.defaultValidityPeriod) }}
                    <div class="input-group">
                        {{ form_widget(form.defaultValidityPeriod.value) }}
                        {{ form_widget(form.defaultValidityPeriod.unit, {'attr': {'class': 'form-select w-auto'}}) }}
                    </div>
                    {{ form_errors(form.defaultValidityPeriod) }}
                </div>

                <div class="mb-3" id="ssgc_configuration_background_image">
                    {{ form_label(form.backgroundImage) }}
                    {{ form_widget(form.backgroundImage) }}
                    {{ form_errors(form.backgroundImage) }}
                </div>

                {{ form_row(form.pageSize) }}
                {{ form_row(form.orientation) }}
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                {{ form_row(form.enabled) }}
                {{ form_row(form.default) }}
                {% hook 'channelConfigurations' %}
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            {{ 'setono_sylius_gift_card.ui.gift_card_configuration.pdf_live_rendering.title'|trans }}
        </h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.template, {'attr': {'rows': 35}}) }}

                {% if resource.id is not null %}
                    <button type="button" class="btn btn-primary mt-3 js-ssgc-apply-pdf-changes"
                            data-url="{{ path('setono_sylius_gift_card_admin_ajax_generate_pdf', {'id': resource.id}) }}">
                        {{ ux_icon('tabler:check', {'class': 'icon me-2'}) }}
                        {{ 'setono_sylius_gift_card.ui.update_preview'|trans }}
                    </button>
                {% endif %}
            </div>

            <div class="col-md-6 js-ssgc-live-render-container" style="height: 900px;">
                <embed id="js-ssgc-live-render-box"
                       src="data:application/pdf;base64,{{ ssgc_get_base64_encoded_example_pdf_content(resource, true) }}"
                       style="width: 100%; height: 100%; border: 1px solid var(--tblr-border-color); border-radius: 4px;"
                />
            </div>
        </div>
    </div>
</div>
